  <bpmn:process id="talimatKontrol_eodTransfer" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEvent_1" name="Gün Sonu Talimat Kontrolü">
      <bpmn:outgoing>Flow_0qwq1t9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0ryevn9">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 34 23 * * ?</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_03wetdm" name="Talimat Aktif Mi?">
      <bpmn:incoming>Flow_0s62efd</bpmn:incoming>
      <bpmn:outgoing>Flow_12l12bl</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ejtjqr</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_16ahq8x" name="">
      <bpmn:incoming>Flow_1vi7te3</bpmn:incoming>
      <bpmn:incoming>Flow_1qqn6nc</bpmn:incoming>
      <bpmn:incoming>Flow_1smrj3w</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0si70lj" name="Ödenmesi Gereken Borç Var Mı?">
      <bpmn:incoming>Flow_0iwy9wn</bpmn:incoming>
      <bpmn:outgoing>Flow_0s62efd</bpmn:outgoing>
      <bpmn:outgoing>Flow_1vi7te3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0s62efd" name="Evet" sourceRef="Gateway_0si70lj" targetRef="Gateway_03wetdm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${odemeBorcuVar == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12l12bl" name="Hayır" sourceRef="Gateway_03wetdm" targetRef="Activity_1prhap9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isActive != 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_1prhap9" name="Kullanıcıya Talimat (is_active) Kapalı Ödeme Yapılamadı Bilgisi" camunda:type="external" camunda:topic="talimat-kapali-mesaji">
      <bpmn:incoming>Flow_12l12bl</bpmn:incoming>
      <bpmn:outgoing>Flow_1qqn6nc</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1vi7te3" name="Hayır" sourceRef="Gateway_0si70lj" targetRef="Event_16ahq8x">
